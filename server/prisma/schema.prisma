// مخطط قاعدة بيانات مطعم Syrup.
//
// MySQL 8 على InnoDB: العلاقة بين الطلب وأصنافه علائقية بحتة،
// والمبالغ تُخزَّن DECIMAL لا FLOAT حتى لا تتراكم أخطاء الفاصلة.
//
// ملاحظة عن الوقت: MySQL لا يملك نوعًا واعيًا بالمنطقة الزمنية،
// لذلك كل التواريخ تُخزَّن UTC ويتم التحويل في الواجهة فقط.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  delivering
  completed
  cancelled
}

enum Fulfilment {
  delivery
  pickup
}

enum PaymentMethod {
  cash
  card
}

enum PaymentStatus {
  due
  paid
  refunded
  failed
}

enum ContactSubject {
  table_reservation
  private_event
  large_order
  general_enquiry
}

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  fullName     String   @map("full_name") @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  phone        String   @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(customer)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  orders        Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Category {
  id           Int    @id @default(autoincrement())
  name         String @unique @db.VarChar(60)
  slug         String @unique @db.VarChar(60)
  displayOrder Int    @default(0) @map("display_order") @db.SmallInt

  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(160)
  categoryId  Int      @map("category_id")
  price       Decimal  @db.Decimal(10, 2)
  description String   @db.Text
  imageUrl    String   @map("image_url") @db.Text
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model Order {
  id          String @id @default(uuid()) @db.Char(36)
  orderNumber String @unique @map("order_number") @db.VarChar(20)

  // فارغ للطلبات كضيف.
  userId String? @map("user_id") @db.Char(36)

  customerName  String  @map("customer_name") @db.VarChar(120)
  customerPhone String  @map("customer_phone") @db.VarChar(20)
  customerEmail String? @map("customer_email") @db.VarChar(255)

  fulfilment Fulfilment

  addressLine  String?  @map("address_line") @db.VarChar(255)
  addressNotes String?  @map("address_notes") @db.VarChar(255)
  addressLat   Decimal? @map("address_lat") @db.Decimal(10, 7)
  addressLng   Decimal? @map("address_lng") @db.Decimal(10, 7)

  // كل هذه تُحسب على الخادم. أي مبلغ يرسله العميل يُتجاهل.
  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @map("delivery_fee") @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  currency    String  @default("AED") @db.Char(3)

  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(due) @map("payment_status")
  paymentRef    String?       @map("payment_ref") @db.VarChar(64)
  cardLast4     String?       @map("card_last4") @db.Char(4)

  scheduledFor String  @default("asap") @map("scheduled_for") @db.VarChar(20)
  notes        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Char(36)
  orderId String @map("order_id") @db.Char(36)

  // يبقى الصنف مرتبطًا ما دام موجودًا، لكن الاسم والسعر مُصوَّران
  // لحظة الطلب حتى لا يغيّر تعديلُ القائمة الفواتيرَ القديمة.
  menuItemId String? @map("menu_item_id") @db.Char(36)

  itemName  String  @map("item_name") @db.VarChar(150)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity  Int     @db.UnsignedSmallInt
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model ContactMessage {
  id        String         @id @default(uuid()) @db.Char(36)
  fullName  String         @map("full_name") @db.VarChar(120)
  email     String         @db.VarChar(255)
  phone     String?        @db.VarChar(20)
  subject   ContactSubject
  message   String         @db.Text
  isRead    Boolean        @default(false) @map("is_read")
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

/// إعدادات المطعم القابلة للتعديل من لوحة الإدارة.
/// صف واحد فقط، معرّفه ثابت = 1.
model Setting {
  id Int @id @default(1)

  deliveryFee              Decimal @map("delivery_fee") @db.Decimal(10, 2)
  currency                 String  @default("AED") @db.Char(3)
  minimumOrder             Decimal @default(0) @map("minimum_order") @db.Decimal(10, 2)
  deliveryEtaMinutesMin    Int     @default(35) @map("delivery_eta_minutes_min")
  deliveryEtaMinutesMax    Int     @default(45) @map("delivery_eta_minutes_max")
  pickupEtaMinutesMin      Int     @default(15) @map("pickup_eta_minutes_min")
  pickupEtaMinutesMax      Int     @default(20) @map("pickup_eta_minutes_max")
  isAcceptingOrders        Boolean @default(true) @map("is_accepting_orders")

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("settings")
}
