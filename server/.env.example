# ------------------------------------------------------------------
# إعدادات الخادم — انسخ هذا الملف إلى .env واملأ القيم.
# .env مستثنى من Git ولا يجب رفعه أبدًا.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MySQL 8 محلي. إن كان XAMPP يحجز 3306 لـ MariaDB، استخدم 3307.
DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/syrup"

# أسرار التوقيع — ولّد قيمًا عشوائية طويلة لكل بيئة:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# الواجهة المسموح لها بالاتصال. قائمة مفصولة بفواصل.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# حدّ الطلبات لكل نافذة زمنية.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

LOG_LEVEL=info
